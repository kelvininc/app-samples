{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MQTT Mosquitto Configuration",
  "description": "Listener ports, authentication and TLS for the broker.",
  "type": "object",
  "properties": {
    "listeners": {
      "type": "object",
      "title": "Listeners",
      "description": "Enable at least one listener; the broker exits if both are DISABLED.",
      "properties": {
        "plain": {
          "type": "object",
          "title": "Plain Listener",
          "description": "Unencrypted MQTT on its own port. Pick Disabled to turn it off; the secure listener must then be enabled or the broker exits.",
          "oneOf": [
            {
              "title": "Disabled",
              "description": "No plain listener. The secure listener must then be enabled or the broker exits.",
              "properties": {
                "mode": {
                  "type": "string",
                  "title": "Mode",
                  "description": "Whether the plain listener runs, and how clients authenticate on it.",
                  "const": "DISABLED",
                  "default": "DISABLED"
                }
              },
              "required": [
                "mode"
              ]
            },
            {
              "title": "Anonymous",
              "description": "Plain listener accepting any client.",
              "properties": {
                "mode": {
                  "type": "string",
                  "title": "Mode",
                  "description": "Whether the plain listener runs, and how clients authenticate on it.",
                  "const": "ANONYMOUS",
                  "default": "ANONYMOUS"
                },
                "port": {
                  "type": "integer",
                  "title": "Port",
                  "description": "Plain MQTT port; keep it in sync with the service port.",
                  "minimum": 1,
                  "maximum": 65535,
                  "default": 21883
                }
              },
              "required": [
                "mode",
                "port"
              ]
            },
            {
              "title": "Username and password",
              "description": "Plain listener requiring credentials.",
              "properties": {
                "mode": {
                  "type": "string",
                  "title": "Mode",
                  "description": "Whether the plain listener runs, and how clients authenticate on it.",
                  "const": "PASSWORD",
                  "default": "PASSWORD"
                },
                "port": {
                  "type": "integer",
                  "title": "Port",
                  "description": "Plain MQTT port; keep it in sync with the service port.",
                  "minimum": 1,
                  "maximum": 65535,
                  "default": 21883
                },
                "username": {
                  "type": "string",
                  "title": "Username",
                  "description": "MQTT username for the plain listener. Wire to a secret. Accounts are broker-wide, so it must differ from the secure listener's username.",
                  "minLength": 1,
                  "default": "<% secrets.mqtt-user %>"
                },
                "password": {
                  "type": "string",
                  "title": "Password",
                  "description": "MQTT password for the plain listener. Wire to a secret.",
                  "minLength": 1,
                  "default": "<% secrets.mqtt-password %>"
                }
              },
              "required": [
                "mode",
                "port",
                "username",
                "password"
              ]
            }
          ]
        },
        "secure": {
          "type": "object",
          "title": "Secure Listener",
          "description": "TLS MQTT on its own port. Pick Disabled to turn it off; either enabled option requires all three certificates.",
          "oneOf": [
            {
              "title": "Disabled",
              "description": "No TLS listener. The plain listener must then be enabled or the broker exits.",
              "properties": {
                "mode": {
                  "type": "string",
                  "title": "Mode",
                  "description": "Whether the secure listener runs, and how clients authenticate on it.",
                  "const": "DISABLED",
                  "default": "DISABLED"
                }
              },
              "required": [
                "mode"
              ]
            },
            {
              "title": "Enabled, anonymous",
              "description": "TLS listener accepting any client.",
              "properties": {
                "mode": {
                  "type": "string",
                  "title": "Mode",
                  "description": "Whether the secure listener runs, and how clients authenticate on it.",
                  "const": "ANON_TLS",
                  "default": "ANON_TLS"
                },
                "port": {
                  "type": "integer",
                  "title": "Port",
                  "description": "TLS MQTT port; keep it in sync with the service port.",
                  "minimum": 1,
                  "maximum": 65535
                },
                "tls": {
                  "type": "object",
                  "title": "TLS",
                  "description": "PEM content for the secure listener. All three are required; the broker refuses to start rather than listen unencrypted.",
                  "properties": {
                    "ca_crt": {
                      "type": "string",
                      "title": "CA Certificate",
                      "description": "PEM CA bundle that signed the server certificate. Wire to a secret.",
                      "minLength": 1,
                      "default": "<% secrets.mqtt-ssl-ca-crt %>"
                    },
                    "tls_crt": {
                      "type": "string",
                      "title": "Server Certificate",
                      "description": "PEM server certificate presented to clients. Wire to a secret.",
                      "minLength": 1,
                      "default": "<% secrets.mqtt-ssl-tls-crt %>"
                    },
                    "tls_key": {
                      "type": "string",
                      "title": "Server Key",
                      "description": "PEM private key for the server certificate. Wire to a secret.",
                      "minLength": 1,
                      "default": "<% secrets.mqtt-ssl-tls-key %>"
                    }
                  },
                  "required": [
                    "ca_crt",
                    "tls_crt",
                    "tls_key"
                  ]
                }
              },
              "required": [
                "mode",
                "port",
                "tls"
              ]
            },
            {
              "title": "Enabled, username and password",
              "description": "TLS listener requiring credentials.",
              "properties": {
                "mode": {
                  "type": "string",
                  "title": "Mode",
                  "description": "Whether the secure listener runs, and how clients authenticate on it.",
                  "const": "AUTH_TLS",
                  "default": "AUTH_TLS"
                },
                "port": {
                  "type": "integer",
                  "title": "Port",
                  "description": "TLS MQTT port; keep it in sync with the service port.",
                  "minimum": 1,
                  "maximum": 65535
                },
                "username": {
                  "type": "string",
                  "title": "Username",
                  "description": "MQTT username for the secure listener. Wire to a secret. Accounts are broker-wide, so it must differ from the plain listener's username.",
                  "minLength": 1,
                  "default": "<% secrets.mqtt-ssl-user %>"
                },
                "password": {
                  "type": "string",
                  "title": "Password",
                  "description": "MQTT password for the secure listener. Wire to a secret.",
                  "minLength": 1,
                  "default": "<% secrets.mqtt-ssl-password %>"
                },
                "tls": {
                  "type": "object",
                  "title": "TLS",
                  "description": "PEM content for the secure listener. All three are required; the broker refuses to start rather than listen unencrypted.",
                  "properties": {
                    "ca_crt": {
                      "type": "string",
                      "title": "CA Certificate",
                      "description": "PEM CA bundle that signed the server certificate. Wire to a secret.",
                      "minLength": 1,
                      "default": "<% secrets.mqtt-ssl-ca-crt %>"
                    },
                    "tls_crt": {
                      "type": "string",
                      "title": "Server Certificate",
                      "description": "PEM server certificate presented to clients. Wire to a secret.",
                      "minLength": 1,
                      "default": "<% secrets.mqtt-ssl-tls-crt %>"
                    },
                    "tls_key": {
                      "type": "string",
                      "title": "Server Key",
                      "description": "PEM private key for the server certificate. Wire to a secret.",
                      "minLength": 1,
                      "default": "<% secrets.mqtt-ssl-tls-key %>"
                    }
                  },
                  "required": [
                    "ca_crt",
                    "tls_crt",
                    "tls_key"
                  ]
                }
              },
              "required": [
                "mode",
                "port",
                "username",
                "password",
                "tls"
              ]
            }
          ]
        }
      }
    }
  },
  "required": [],
  "x-kelvin-ui": {
    "ui:order": [
      "listeners"
    ],
    "listeners": {
      "ui:order": [
        "plain",
        "secure"
      ],
      "plain": {
        "ui:order": [
          "mode",
          "port",
          "username",
          "password"
        ],
        "mode": {
          "ui:widget": "hidden"
        },
        "password": {
          "ui:widget": "password"
        }
      },
      "secure": {
        "ui:order": [
          "mode",
          "port",
          "username",
          "password",
          "tls"
        ],
        "mode": {
          "ui:widget": "hidden"
        },
        "password": {
          "ui:widget": "password"
        },
        "tls": {
          "ui:order": [
            "ca_crt",
            "tls_crt",
            "tls_key"
          ],
          "ca_crt": {
            "ui:widget": "textarea"
          },
          "tls_crt": {
            "ui:widget": "textarea"
          },
          "tls_key": {
            "ui:widget": "textarea"
          }
        }
      }
    }
  }
}
