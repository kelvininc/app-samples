{
  "title": "AWS S3 Exporter Configuration",
  "description": "Bucket, credentials, and upload settings.",
  "type": "object",
  "properties": {
    "s3": {
      "type": "object",
      "title": "AWS S3",
      "description": "Destination bucket and AWS credentials.",
      "properties": {
        "region": {
          "type": "string",
          "title": "Region",
          "description": "AWS region of the bucket.",
          "default": "us-east-1"
        },
        "bucket": {
          "type": "string",
          "title": "Bucket",
          "description": "Destination bucket. Required to deploy."
        },
        "prefix": {
          "type": "string",
          "title": "Key Prefix",
          "description": "Optional folder within the bucket."
        },
        "auth": {
          "type": "object",
          "title": "Authentication",
          "description": "Leave empty to use the AWS default credential chain (IAM role).",
          "properties": {
            "access_key_id": {
              "type": "string",
              "title": "Access Key ID",
              "description": "Leave both credentials empty to use the AWS default credential chain."
            },
            "secret_access_key": {
              "type": "string",
              "title": "Secret Access Key",
              "description": "Set together with the access key ID. Wire to a secret."
            }
          },
          "x-kelvin-ui": {
            "secret_access_key": {
              "ui:widget": "password"
            },
            "ui:order": [
              "access_key_id",
              "secret_access_key"
            ]
          }
        }
      },
      "required": [
        "region",
        "bucket"
      ]
    },
    "upload": {
      "type": "object",
      "title": "Upload",
      "description": "Batching and retry for the drain loop.",
      "properties": {
        "interval": {
          "type": "integer",
          "title": "Interval (s)",
          "description": "Seconds between drain runs.",
          "minimum": 1,
          "default": 60
        },
        "batch_size": {
          "type": "integer",
          "title": "Batch Size",
          "description": "Rows per batch.",
          "minimum": 1,
          "default": 1000
        },
        "format": {
          "type": "string",
          "title": "File Format",
          "description": "Output file format.",
          "enum": [
            "parquet",
            "csv",
            "json"
          ],
          "default": "parquet"
        },
        "retry": {
          "type": "object",
          "title": "Retry",
          "description": "Exponential backoff for a failed batch.",
          "properties": {
            "attempts": {
              "type": "integer",
              "title": "Attempts",
              "description": "Attempts before a batch is abandoned.",
              "minimum": 1,
              "default": 3
            },
            "base_delay": {
              "type": "number",
              "title": "Base Delay (s)",
              "description": "Delay before the first retry; doubles each attempt.",
              "minimum": 0,
              "default": 1
            },
            "max_delay": {
              "type": "number",
              "title": "Max Delay (s)",
              "description": "Ceiling on the backoff delay.",
              "minimum": 0,
              "default": 30
            }
          }
        }
      }
    },
    "buffer": {
      "type": "object",
      "title": "Buffer",
      "description": "Local backlog held between drains.",
      "properties": {
        "max_backlog": {
          "type": "integer",
          "title": "Max Backlog",
          "minimum": 0,
          "default": 1000000,
          "description": "Max un-uploaded rows kept before dropping oldest; 0 = unbounded."
        }
      }
    }
  },
  "required": [
    "s3"
  ]
}
