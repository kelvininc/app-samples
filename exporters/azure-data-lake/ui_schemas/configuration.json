{
  "title": "Azure Data Lake Exporter Configuration",
  "description": "Storage account, credentials, and upload settings.",
  "type": "object",
  "properties": {
    "adls": {
      "type": "object",
      "title": "Azure Data Lake Storage",
      "description": "Storage account, container, and credentials.",
      "properties": {
        "account_name": {
          "type": "string",
          "title": "Storage Account Name",
          "pattern": "^[a-z0-9]{3,24}$",
          "description": "3-24 lowercase letters and digits. Required to deploy.",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "title": "Container (File System)",
          "description": "Required to deploy.",
          "minLength": 1
        },
        "auth": {
          "type": "object",
          "title": "Authentication",
          "description": "Storage account access key. Wire it to a secret on deployment.",
          "properties": {
            "account_key": {
              "type": "string",
              "title": "Account Key",
              "description": "Leave empty to use the cluster's managed identity. Wire to a secret."
            }
          }
        }
      },
      "required": [
        "account_name",
        "container"
      ]
    },
    "upload": {
      "type": "object",
      "title": "Upload",
      "description": "Batching and retry for the drain loop.",
      "properties": {
        "interval": {
          "type": "integer",
          "title": "Interval (s)",
          "description": "Seconds between drain runs.",
          "minimum": 1,
          "default": 60
        },
        "batch_size": {
          "type": "integer",
          "title": "Batch Size",
          "description": "Rows per batch.",
          "minimum": 1,
          "maximum": 100000,
          "default": 1000
        },
        "format": {
          "type": "string",
          "title": "File Format",
          "description": "Output file format.",
          "enum": [
            "parquet",
            "csv",
            "json"
          ],
          "default": "parquet"
        },
        "retry": {
          "type": "object",
          "title": "Retry",
          "description": "Exponential backoff for a failed batch.",
          "properties": {
            "attempts": {
              "type": "integer",
              "title": "Attempts",
              "description": "Attempts before a batch is abandoned.",
              "minimum": 1,
              "default": 3
            },
            "base_delay": {
              "type": "number",
              "title": "Base Delay (s)",
              "description": "Delay before the first retry; doubles each attempt.",
              "minimum": 0,
              "default": 1
            },
            "max_delay": {
              "type": "number",
              "title": "Max Delay (s)",
              "description": "Ceiling on the backoff delay.",
              "minimum": 0,
              "default": 30
            }
          }
        }
      }
    },
    "buffer": {
      "type": "object",
      "title": "Buffer",
      "description": "Local backlog held between drains.",
      "properties": {
        "max_backlog": {
          "type": "integer",
          "title": "Max Backlog",
          "minimum": 0,
          "default": 1000000,
          "description": "Max un-uploaded rows kept before dropping oldest; 0 = unbounded."
        }
      }
    }
  },
  "required": [
    "adls"
  ],
  "x-kelvin-ui": {
    "ui:order": [
      "adls",
      "upload",
      "buffer"
    ],
    "adls": {
      "ui:order": [
        "account_name",
        "container",
        "auth"
      ],
      "auth": {
        "ui:order": [
          "account_key"
        ],
        "account_key": {
          "ui:widget": "password"
        }
      }
    },
    "upload": {
      "ui:order": [
        "interval",
        "batch_size",
        "format",
        "retry"
      ],
      "retry": {
        "ui:order": [
          "attempts",
          "base_delay",
          "max_delay"
        ]
      }
    },
    "buffer": {
      "ui:order": [
        "max_backlog"
      ]
    }
  }
}
