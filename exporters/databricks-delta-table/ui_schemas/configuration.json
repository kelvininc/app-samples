{
  "type": "object",
  "properties": {
    "databricks": {
      "type": "object",
      "title": "Databricks",
      "properties": {
        "server_hostname": { "type": "string", "title": "Server Hostname" },
        "http_path": { "type": "string", "title": "HTTP Path" },
        "delta_table": { "type": "string", "title": "Delta Table", "description": "Fully-qualified name: catalog.schema.table.",
                         "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$" },
        "auth": {
          "type": "object",
          "title": "Authentication",
          "description": "Wire credentials to a secret on deployment.",
          "properties": {
            "method": {
              "type": "string", "title": "Method",
              "enum": ["oauth", "access_token"], "default": "oauth"
            }
          },
          "required": ["method"],
          "allOf": [
            {
              "if": { "properties": { "method": { "const": "oauth" } } },
              "then": {
                "properties": {
                  "client_id": { "type": "string", "title": "Client ID" },
                  "client_secret": { "type": "string", "title": "Client Secret" }
                },
                "required": ["client_id", "client_secret"]
              }
            },
            {
              "if": { "properties": { "method": { "const": "access_token" } } },
              "then": {
                "properties": { "access_token": { "type": "string", "title": "Access Token" } },
                "required": ["access_token"]
              }
            }
          ],
          "x-kelvin-ui": {
            "client_secret": { "ui:widget": "password" },
            "access_token": { "ui:widget": "password" },
            "ui:order": ["method", "client_id", "client_secret", "access_token"]
          }
        }
      },
      "required": ["server_hostname", "http_path", "delta_table", "auth"]
    },
    "upload": {
      "type": "object",
      "title": "Upload",
      "properties": {
        "interval": { "type": "integer", "title": "Interval (s)", "minimum": 1, "default": 60 },
        "batch_size": { "type": "integer", "title": "Batch Size", "minimum": 1, "default": 1000 },
        "retry": {
          "type": "object",
          "title": "Retry",
          "properties": {
            "attempts": { "type": "integer", "title": "Attempts", "minimum": 1, "default": 3 },
            "base_delay": { "type": "number", "title": "Base Delay (s)", "minimum": 0, "default": 1 },
            "max_delay": { "type": "number", "title": "Max Delay (s)", "minimum": 0, "default": 30 }
          }
        }
      }
    },
    "buffer": {
      "type": "object",
      "title": "Buffer",
      "properties": {
        "max_backlog": { "type": "integer", "title": "Max Backlog", "minimum": 0, "default": 0,
                         "description": "Max un-uploaded rows kept before dropping oldest; 0 = unbounded." }
      }
    }
  },
  "required": ["databricks"]
}
