{
  "title": "Email Message",
  "description": "Payload schema for the Email Message custom action.",
  "type": "object",
  "properties": {
    "to": {
      "title": "To",
      "description": "Recipients: a single email address, or a list of addresses",
      "anyOf": [
        {
          "type": "string",
          "format": "email",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Subject",
      "description": "Subject line of the email"
    },
    "message": {
      "type": "object",
      "title": "Message",
      "description": "The body of the email.",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "description": "Body text of the email"
        }
      },
      "required": [
        "text"
      ]
    }
  },
  "required": [
    "to",
    "subject",
    "message"
  ],
  "additionalProperties": false
}
