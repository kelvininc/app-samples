{
  "title": "SFTP Exporter Configuration",
  "description": "Server connection, credentials, and upload settings.",
  "type": "object",
  "properties": {
    "sftp": {
      "type": "object",
      "title": "SFTP",
      "description": "Server connection and credentials.",
      "properties": {
        "host": {
          "type": "string",
          "title": "Host",
          "description": "Server hostname. Required to deploy.",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "title": "Port",
          "description": "SSH port.",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "username": {
          "type": "string",
          "title": "Username",
          "description": "Login user. Required to deploy.",
          "minLength": 1
        },
        "remote_dir": {
          "type": "string",
          "title": "Remote Directory",
          "description": "Directory batches are uploaded into.",
          "default": "."
        },
        "timeout": {
          "type": "number",
          "title": "Timeout (s)",
          "exclusiveMinimum": 0,
          "default": 30,
          "description": "Network timeout in seconds for connect/auth/transfers."
        },
        "verify_host_key": {
          "type": "boolean",
          "title": "Verify Host Key",
          "description": "Disable only in development; unverified keys allow MITM.",
          "default": true
        },
        "known_hosts": {
          "type": "string",
          "title": "Known Hosts Path",
          "description": "Optional known_hosts file."
        },
        "auth": {
          "type": "object",
          "title": "Authentication",
          "description": "Wire credentials to a secret on deployment.",
          "oneOf": [
            {
              "title": "Password auth",
              "properties": {
                "method": {
                  "type": "string",
                  "title": "Method",
                  "description": "password uses a password; private_key uses a PEM key.",
                  "const": "password",
                  "default": "password"
                },
                "password": {
                  "type": "string",
                  "title": "Password",
                  "description": "password method only. Wire to a secret."
                }
              },
              "required": [
                "method"
              ]
            },
            {
              "title": "SSH key auth",
              "properties": {
                "method": {
                  "type": "string",
                  "title": "Method",
                  "description": "password uses a password; private_key uses a PEM key.",
                  "const": "private_key",
                  "default": "private_key"
                },
                "private_key": {
                  "type": "string",
                  "title": "Private Key (PEM)",
                  "description": "PEM key (RSA/Ed25519/ECDSA); private_key method only."
                },
                "private_key_passphrase": {
                  "type": "string",
                  "title": "Private Key Passphrase",
                  "description": "Only if the key is encrypted. Wire to a secret."
                }
              },
              "required": [
                "method"
              ]
            }
          ]
        }
      },
      "required": [
        "host",
        "username",
        "auth"
      ]
    },
    "upload": {
      "type": "object",
      "title": "Upload",
      "description": "Batching and retry for the drain loop.",
      "properties": {
        "interval": {
          "type": "integer",
          "title": "Interval (s)",
          "description": "Seconds between drain runs.",
          "minimum": 1,
          "default": 60
        },
        "batch_size": {
          "type": "integer",
          "title": "Batch Size",
          "description": "Rows per batch.",
          "minimum": 1,
          "default": 1000
        },
        "format": {
          "type": "string",
          "title": "File Format",
          "description": "Output file format.",
          "enum": [
            "parquet",
            "csv",
            "json"
          ],
          "default": "parquet"
        },
        "retry": {
          "type": "object",
          "title": "Retry",
          "description": "Exponential backoff for a failed batch.",
          "properties": {
            "attempts": {
              "type": "integer",
              "title": "Attempts",
              "description": "Attempts before a batch is abandoned.",
              "minimum": 1,
              "default": 3
            },
            "base_delay": {
              "type": "number",
              "title": "Base Delay (s)",
              "description": "Delay before the first retry; doubles each attempt.",
              "minimum": 0,
              "default": 1
            },
            "max_delay": {
              "type": "number",
              "title": "Max Delay (s)",
              "description": "Ceiling on the backoff delay.",
              "minimum": 0,
              "default": 30
            }
          }
        }
      }
    },
    "buffer": {
      "type": "object",
      "title": "Buffer",
      "description": "Local backlog held between drains.",
      "properties": {
        "max_backlog": {
          "type": "integer",
          "title": "Max Backlog",
          "minimum": 0,
          "default": 1000000,
          "description": "Max un-uploaded rows kept before dropping oldest; 0 = unbounded."
        }
      }
    }
  },
  "required": [
    "sftp"
  ],
  "x-kelvin-ui": {
    "ui:order": [
      "sftp",
      "upload",
      "buffer"
    ],
    "sftp": {
      "ui:order": [
        "host",
        "port",
        "username",
        "remote_dir",
        "timeout",
        "verify_host_key",
        "known_hosts",
        "auth"
      ],
      "auth": {
        "ui:order": [
          "method",
          "password",
          "private_key",
          "private_key_passphrase"
        ],
        "password": {
          "ui:widget": "password"
        },
        "private_key": {
          "ui:widget": "textarea"
        },
        "private_key_passphrase": {
          "ui:widget": "password"
        },
        "method": {
          "ui:widget": "hidden"
        }
      }
    },
    "upload": {
      "ui:order": [
        "interval",
        "batch_size",
        "format",
        "retry"
      ],
      "retry": {
        "ui:order": [
          "attempts",
          "base_delay",
          "max_delay"
        ]
      }
    },
    "buffer": {
      "ui:order": [
        "max_backlog"
      ]
    }
  }
}
