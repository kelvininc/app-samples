{
  "type": "object",
  "properties": {
    "snowflake": {
      "type": "object",
      "title": "Snowflake",
      "properties": {
        "account": { "type": "string", "title": "Account", "description": "Account identifier, e.g. xy12345.us-east-1." },
        "user": { "type": "string", "title": "User" },
        "warehouse": { "type": "string", "title": "Warehouse" },
        "database": { "type": "string", "title": "Database", "pattern": "^$|^[A-Za-z0-9_]+$" },
        "schema": { "type": "string", "title": "Schema", "pattern": "^$|^[A-Za-z0-9_]+$" },
        "table": { "type": "string", "title": "Table", "pattern": "^$|^[A-Za-z0-9_]+$" },
        "auth": {
          "type": "object",
          "title": "Authentication",
          "description": "Wire credentials to a secret on deployment.",
          "properties": {
            "method": {
              "type": "string", "title": "Method",
              "enum": ["password", "key_pair"], "default": "password"
            }
          },
          "required": ["method"],
          "allOf": [
            {
              "if": { "properties": { "method": { "const": "password" } } },
              "then": {
                "properties": { "password": { "type": "string", "title": "Password" } }
              }
            },
            {
              "if": { "properties": { "method": { "const": "key_pair" } } },
              "then": {
                "properties": {
                  "private_key": { "type": "string", "title": "Private Key (PEM)" },
                  "private_key_passphrase": { "type": "string", "title": "Private Key Passphrase" }
                }
              }
            }
          ],
          "x-kelvin-ui": {
            "password": { "ui:widget": "password" },
            "private_key": { "ui:widget": "textarea" },
            "private_key_passphrase": { "ui:widget": "password" },
            "ui:order": ["method", "password", "private_key", "private_key_passphrase"]
          }
        }
      },
      "required": ["account", "user", "warehouse", "database", "schema", "table", "auth"]
    },
    "upload": {
      "type": "object",
      "title": "Upload",
      "properties": {
        "interval": { "type": "integer", "title": "Interval (s)", "minimum": 1, "default": 60 },
        "batch_size": { "type": "integer", "title": "Batch Size", "minimum": 1, "default": 1000 },
        "retry": {
          "type": "object",
          "title": "Retry",
          "properties": {
            "attempts": { "type": "integer", "title": "Attempts", "minimum": 1, "default": 3 },
            "base_delay": { "type": "number", "title": "Base Delay (s)", "minimum": 0, "default": 1 },
            "max_delay": { "type": "number", "title": "Max Delay (s)", "minimum": 0, "default": 30 }
          }
        }
      }
    },
    "buffer": {
      "type": "object",
      "title": "Buffer",
      "properties": {
        "max_backlog": { "type": "integer", "title": "Max Backlog", "minimum": 0, "default": 0,
                         "description": "Max un-uploaded rows kept before dropping oldest; 0 = unbounded." }
      }
    }
  },
  "required": ["snowflake"]
}
